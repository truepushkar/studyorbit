<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.StudyOrbit.Card"
    android:background="@drawable/widget_planner_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

            <LinearLayout
                style="@style/Widget.StudyOrbit.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_ready" />

                <TextView
                    android:id="@+id/widget_pill_text"
                    style="@style/Widget.StudyOrbit.PillText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_day_today" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_badge"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_planner"
            android:tint="@color/widget_planner_accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hero"
        style="@style/Widget.StudyOrbit.Hero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:text="@string/widget_sample_time" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_sample_title"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_chip"
            style="@style/Widget.StudyOrbit.PillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_sample_duration"
            android:textColor="@color/widget_planner_accent" />
    </LinearLayout>
</LinearLayout>
