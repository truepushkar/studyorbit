<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.StudyOrbit.Card"
    android:background="@drawable/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="7dp"
            android:padding="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_focus"
            android:tint="@color/widget_accent" />

        <TextView
            style="@style/Widget.StudyOrbit.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_accent"
            android:text="@string/widget_focus_heading" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_rail_expand"
            android:tint="@color/widget_accent" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Chronometer
        android:id="@+id/widget_clock"
        style="@style/Widget.StudyOrbit.Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textSize="32sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeMaxTextSize="32sp"
        android:autoSizeStepGranularity="1sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_value"
        style="@style/Widget.StudyOrbit.Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFeatureSettings="tnum"
        android:text="@string/widget_focus_idle" />

    <TextView
        android:id="@+id/widget_detail"
        style="@style/Widget.StudyOrbit.Detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_open_focus" />
</LinearLayout>
