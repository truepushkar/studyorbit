<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="8dp">
    <TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_unavailable" android:textSize="27sp" android:textColor="@color/widget_mint" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_focus_caption" android:textSize="12sp" android:textColor="@color/widget_muted"  />
    <TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp"
        android:background="@drawable/widget_pill" android:text="@string/widget_start_focus" android:textColor="@color/widget_action_text"
        android:textStyle="bold" android:textSize="13sp" android:gravity="center" android:maxLines="1" />
</LinearLayout>
