<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.StudyOrbit.Card"
    android:background="@drawable/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- The pill sits in a weighted frame so a long status never pushes the badge out. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

            <LinearLayout
                style="@style/Widget.StudyOrbit.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/widget_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_ready" />

                <TextView
                    android:id="@+id/widget_status"
                    style="@style/Widget.StudyOrbit.PillText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_focus_idle" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_badge"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_focus"
            android:tint="@color/widget_accent" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/widget_clock"
        style="@style/Widget.StudyOrbit.Hero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="44sp"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFeatureSettings="tnum"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_value"
        style="@style/Widget.StudyOrbit.Hero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="44sp"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFeatureSettings="tnum"
        android:text="@string/widget_sample_clock" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/widget_goal_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="100"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progress="58"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/widget_goal_text"
            style="@style/Widget.StudyOrbit.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/widget_sample_goal" />
    </LinearLayout>
</LinearLayout>
