<?xml version="1.0" encoding="utf-8"?>
<!-- Focus widget: indigo night with two faint orbit rings around the corner badge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#3A2C70" android:endColor="#171629" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:width="120dp" android:height="120dp" android:gravity="top|end"
        android:top="-32dp" android:end="-30dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
    <item android:width="48dp" android:height="48dp" android:gravity="top|end"
        android:top="4dp" android:end="6dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#29FFBCAC" />
        </shape>
    </item>
</layer-list>
